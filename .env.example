# Copy to .env and adjust. Never commit a filled-in .env.

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
# Leave empty for SQLite (local only); docker-compose sets PostgreSQL.
DATABASE_URL=
TIME_ZONE=UTC

# --- URLs -----------------------------------------------------------------
# Where the web app runs (OAuth returns here) and the base of the students' survey links.
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# --- Email ----------------------------------------------------------------
# Empty EMAIL_HOST prints emails to the console. docker-compose points it at Mailpit.
EMAIL_HOST=
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Training Office <training@academy.example>

# --- Demo -----------------------------------------------------------------
ORG_NAME=Demo Academy
# Password of the seeded "coordinator" account (min. 8 characters).
DEMO_PASSWORD=
# How long a mock Google connection lasts before it "expires" (days, decimals allowed).
MOCK_TOKEN_DAYS=7

# --- Integrations (only the offline mocks are implemented) -----------------
GOOGLE_MODE=mock
WHATSAPP_MODE=mock
CLASSROOM_PROVIDER=fake
CLASSROOM_MIN_COHORT=100
CLASSROOM_SYNC_MINUTES=15
CLASSROOM_AUTO_IMPORT=0
SCHEDULER_TICK_SECONDS=60
